# -----------------------------
# SECOND LIFE ACCOUNT
# -----------------------------
SL_FIRST_NAME=
SL_LAST_NAME=Resident
SL_PASSWORD=

# Your avatar UUID. Only this UUID can use !admin commands.
OWNER_UUID=

# -----------------------------
# AI PROVIDER
# -----------------------------
# OLLAMA = local only. Never falls back.
# SOJI   = Soji only. Never falls back.
# AUTO   = explicitly allows fallback in AUTO_ORDER.
AI_PROVIDER=OLLAMA
AUTO_ORDER=OLLAMA,SOJI

# Local Ollama OpenAI-compatible endpoint.
OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen3-airoguelite-fast:latest

# Soji. SOJI_BASE_URL may be either the API root or the full /v1/chat/completions URL.
SOJI_BASE_URL=
SOJI_API_KEY=
SOJI_MODEL=
SOJI_USER_AGENT=starlablood/1.0

# -----------------------------
# BOT BEHAVIOR
# -----------------------------
# IMs are handled by AI automatically. Nearby chat is OFF by default to avoid spam.
RESPOND_TO_LOCAL_CHAT=false
LOCAL_CHAT_REQUIRE_NAME=true
MAX_OUTPUT_CHARS=900
PERSONA_FILE=persona.txt
